<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="description" content="Track free models on OpenRouter, ranked by coding capability">
  <title>OpenRouter Free Models Tracker</title>
  <link rel="alternate" type="application/atom+xml" title="OpenRouter Free Models Feed" href="atom.xml">
  <link rel="stylesheet" href="assets/styles.css">
</head>
<body>

{% macro copy_button(model) -%}
<button class="copy-btn" data-model-id="{{ model.id }}" aria-label="Copy {{ model.id }}" title="Copy model ID">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
</button>
{%- endmacro %}

{% macro coding_badge(model) -%}
<span class="badge-coding {{ model.coding_index | coding_index_color }}">{% if model.coding_index is not none %}{{ "%.1f"|format(model.coding_index) }}{% else %}N/A{% endif %}</span>
{%- endmacro %}

{% macro modality_badges(model) -%}
<div class="modal-badges">{% for badge in model.modalities_badges %}<span class="modal-badge">{{ badge }}</span>{% endfor %}</div>
{%- endmacro %}

{% macro details_block(model) -%}
<details class="disclosure">
  <summary>Details</summary>
  <div class="disclosure-body">
    <dl class="stat-list">
      <div><dt>Intelligence</dt><dd>{% if model.intelligence_index is not none %}{{ "%.1f"|format(model.intelligence_index) }}{% else %}N/A{% endif %}</dd></div>
      <div><dt>3D Elo</dt><dd>{% if model.three_d_elo is not none %}{{ model.three_d_elo | int }} ({{ "%.1f"|format(model.three_d_win_rate) }}%{% if model.three_d_rank is not none %}, #{{ model.three_d_rank }}{% endif %}){% else %}N/A{% endif %}</dd></div>
      <div><dt>Error rate</dt><dd>{% if model.error_rate_pct is not none %}{{ "%.2f"|format(model.error_rate_pct) }}%{% else %}N/A{% endif %}</dd></div>
      <div><dt>Tokens (24h)</dt><dd>{% if model.token_volume_24h is not none %}{{ model.token_volume_24h | humanize_tokens }}{% else %}N/A{% endif %}</dd></div>
      <div><dt>Reasoning</dt><dd>{{ model.reasoning | reasoning_summary }}</dd></div>
    </dl>
    <p class="model-description">{{ model.description }}</p>
  </div>
</details>
{%- endmacro %}

{% macro table_row(model) -%}
<tr class="{% if model.is_expired %}expired{% endif %}"
    data-model-id="{{ model.id }}"
    data-name="{{ model.name | lower }}"
    data-modalities="{{ model.architecture.input_modalities | join(',') }}"
    data-expired="{{ 'true' if model.is_expired else 'false' }}"
    data-rank="{{ model.rank }}"
    data-coding="{{ model.coding_index if model.coding_index is not none else -1 }}"
    data-context="{{ model.context_length }}"
    data-tokens="{{ model.token_volume_24h if model.token_volume_24h is not none else -1 }}"
    data-released="{{ model.release_date.timestamp() }}">
  <td class="rank-num">{{ model.rank }}</td>
  <td class="model-cell">
    <div class="model-name-row">
      <a class="model-name" href="{{ model.openrouter_url }}" target="_blank" rel="noopener">{{ model.name }}</a>
      {% if model.is_expired %}<span class="expired-badge">Expired</span>{% endif %}
    </div>
    <span class="model-id">{{ model.id }} {{ copy_button(model) }}</span>
    {{ details_block(model) }}
  </td>
  <td>{{ coding_badge(model) }}</td>
  <td class="ctx">{{ model.context_length | humanize_tokens }}</td>
  <td class="tok">{% if model.token_volume_24h is not none %}{{ model.token_volume_24h | humanize_tokens }}{% else %}N/A{% endif %}</td>
  <td>{{ modality_badges(model) }}</td>
  <td class="rel"><time datetime="{{ model.release_date.isoformat() }}">{{ model.release_date.strftime('%Y-%m-%d') }}</time></td>
</tr>
{%- endmacro %}

{% macro model_card(model) -%}
<article class="card {% if model.is_expired %}expired{% endif %}"
    data-model-id="{{ model.id }}"
    data-name="{{ model.name | lower }}"
    data-modalities="{{ model.architecture.input_modalities | join(',') }}"
    data-expired="{{ 'true' if model.is_expired else 'false' }}"
    data-rank="{{ model.rank }}"
    data-coding="{{ model.coding_index if model.coding_index is not none else -1 }}"
    data-context="{{ model.context_length }}"
    data-tokens="{{ model.token_volume_24h if model.token_volume_24h is not none else -1 }}"
    data-released="{{ model.release_date.timestamp() }}">
  <div class="card-top">
    <span class="rank-num">{{ model.rank }}</span>
    {{ coding_badge(model) }}
  </div>
  <div class="model-name-row">
    <a class="model-name" href="{{ model.openrouter_url }}" target="_blank" rel="noopener">{{ model.name }}</a>
    {% if model.is_expired %}<span class="expired-badge">Expired</span>{% endif %}
  </div>
  <span class="model-id">{{ model.id }} {{ copy_button(model) }}</span>
  <div class="card-meta">
    <span>{{ model.context_length | humanize_tokens }} ctx</span>
    {% if model.token_volume_24h is not none %}<span class="tok">{{ model.token_volume_24h | humanize_tokens }} tok/24h</span>{% endif %}
    <time datetime="{{ model.release_date.isoformat() }}">{{ model.release_date.strftime('%Y-%m-%d') }}</time>
  </div>
  {{ modality_badges(model) }}
  {{ details_block(model) }}
</article>
{%- endmacro %}

  <header class="site-header">
    <div class="header-inner">
      <p class="kicker">openrouter // free</p>
      <h1>Free Models</h1>
      <p class="subtitle">Free models ranked by coding capability (<a href="https://artificialanalysis.ai" target="_blank" rel="noopener">Artificial Analysis</a> Coding Index)</p>
      <div class="meta-row">
        <span>{{ total_count }} models</span>
        <span>Synced {{ last_updated }}</span>
        <a href="atom.xml">Atom feed</a>
        <a href="https://github.com/{{ github_username }}/{{ repo_name }}" target="_blank" rel="noopener">Source</a>
        <a href="https://openrouter.ai/models" target="_blank" rel="noopener">OpenRouter</a>
      </div>
    </div>
  </header>

  <main>
    <div class="browser">
      <search class="toolbar" aria-label="Filter models">
        <div class="search-field">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"></circle><path d="m21 21-4.3-4.3"></path></svg>
          <input type="search" id="search-input" placeholder="grep model or id&hellip;" aria-label="Search models" autocomplete="off">
        </div>
        <div class="chips" role="group" aria-label="Filter by modality">
          {% for m in modality_list %}
          <button type="button" class="chip" data-modality="{{ m }}" aria-pressed="false">{{ modality_labels[m] }}</button>
          {% endfor %}
        </div>
        <label class="expired-toggle">
          <input type="checkbox" id="hide-expired">
          <span>Hide expired</span>
        </label>
        <div class="sort-field">
          <label for="sort-select">Sort</label>
          <select id="sort-select">
            <option value="rank-asc">Rank</option>
            <option value="coding-desc">Coding, high&rarr;low</option>
            <option value="context-desc">Context, high&rarr;low</option>
            <option value="tokens-desc">Tokens (24h), high&rarr;low</option>
            <option value="released-desc">Released, newest</option>
            <option value="name-asc">Name, A&rarr;Z</option>
          </select>
        </div>
        <button type="button" class="clear-filters" id="clear-filters">Clear</button>
      </search>

      <p class="results-count" id="results-count" aria-live="polite">{{ total_count }} of {{ total_count }} models</p>

      <div class="table-scroll" id="table-scroll">
        <table id="models-table">
          <thead>
            <tr>
              <th data-sort="rank" class="sorted-asc" tabindex="0">#</th>
              <th data-sort="name" tabindex="0">Model</th>
              <th data-sort="coding" tabindex="0">Coding</th>
              <th data-sort="context" tabindex="0">Context</th>
              <th data-sort="tokens" tabindex="0">Tokens (24h)</th>
              <th>Modalities</th>
              <th data-sort="released" tabindex="0">Released</th>
            </tr>
          </thead>
          <tbody>
            {% for model in models %}
            {{ table_row(model) }}
            {% endfor %}
          </tbody>
        </table>
      </div>

      <div class="cards" id="cards">
        {% for model in models %}
        {{ model_card(model) }}
        {% endfor %}
      </div>

      <p class="empty-state" id="empty-state" hidden>No models match your filters.</p>
    </div>
  </main>

  <footer>
    <div class="footer-inner">
      <p>Data from <a class="plain" href="https://openrouter.ai" target="_blank" rel="noopener">OpenRouter API</a> &middot; Rankings by <a class="plain" href="https://artificialanalysis.ai" target="_blank" rel="noopener">Artificial Analysis</a></p>
      <div class="footer-links">
        <a href="atom.xml">Atom Feed</a>
        <a href="https://github.com/{{ github_username }}/{{ repo_name }}" target="_blank" rel="noopener">GitHub</a>
        <a href="https://openrouter.ai/models?max_price=0" target="_blank" rel="noopener">Browse on OpenRouter</a>
      </div>
    </div>
  </footer>

  <div class="toast" id="toast" role="status" aria-live="polite">Copied</div>

  <script src="assets/app.js"></script>
</body>
</html>
